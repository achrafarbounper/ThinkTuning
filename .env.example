API_KEY=REPLACE-ME-min-32-chars-voir-ci-dessous
# P0 SEC (F1) : fail-closed en prod — ensure_api_key_configured() refuse le
# démarrage si ENV=prod et API_KEY absente/faible (< 32 chars). Ne JAMAIS
# commiter une vraie clé. Génération :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#ENV=prod
# P1 SEC (rotation) : ancienne clé encore acceptée pendant la migration des
# clients. API_KEY_OLD_EXPIRES (ISO 8601) rend la grâce fail-closed : une fois
# la date passée, l'ancienne clé est refusée ET le démarrage en prod échoue
# tant qu'API_KEY_OLD reste configurée (rotation achevée = supprimez-la).
#API_KEY_OLD=
#API_KEY_OLD_EXPIRES=2026-12-31T23:59:59Z
# P1 SEC (least-privilege) : clé de LECTURE dédiée (monitoring/CI/dashboard)
# — ouvre /predict*, /models, /classifiers, /explain et le WS métriques,
# JAMAIS les routes d'action (/agent/*, /train, /pipeline). Absente = la clé
# admin couvre tout (comportement historique).
#API_KEY_READ=
# SearXNG (profil compose « search ») : secret injecté (settings.yml le
# référence via $SEARXNG_SECRET — JAMAIS en dur). Génération : même commande.
#SEARXNG_SECRET=REPLACE-ME-voir-ci-dessus
# Origines CORS autorisées (CSV) — lues par api/main.py::_cors_allowed_origins().
# Sans cette variable, seuls les defaults localhost sont actifs.
#   LOCAL : les 4 localhost ci-dessous suffisent (frontend Vite sur :5173).
#   PROD  : AJOUTER IMPÉRATIVEMENT l'origine exacte du frontend déployé
#           (Vercel, SANS slash final), sinon le navigateur bloque les appels
#           par CORS (preflight OPTIONS sans Access-Control-Allow-Origin).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080,http://localhost:5173,http://localhost:3000,https://think-tuning-ai.vercel.app

# --- Inférence / prédiction -----------------------------------------------------------
# Device d'inférence : auto (CUDA si disponible, sinon CPU), cpu ou cuda
#PREDICT_DEVICE=auto
# Bornes anti-DoS de /predict et /predict/batch (valeurs par défaut ci-dessous)
#PREDICT_MAX_TEXTS=256
#PREDICT_MAX_TEXT_CHARS=10000
#PREDICT_BATCH_MAX_BYTES=10485760
#PREDICT_BATCH_MAX_ROWS=20000
# Taille des chunks d'inférence (mémoire bornée sur les gros lots)
#PREDICT_CHUNK_SIZE=64

# --- Rate limiting --------------------------------------------------------------------
# Requêtes POST /predict|/predict/batch|/compare par minute et par IP (0 = off)
#RATE_LIMIT_PER_MINUTE=60
# P0 SEC (F6) : 0 par défaut (X-Forwarded-For spoofable en exposition directe).
# Mettre 1 UNIQUEMENT derrière un reverse proxy de confiance (nginx compose :
# proxy_set_header X-Forwarded-For — compose injecte déjà RATE_LIMIT_TRUST_PROXY=1
# pour le service « app »). Documenté dans docs/SECURITY_DIAGNOSTIC.md.
#RATE_LIMIT_TRUST_PROXY=0
# P1 SEC (point 12) : quotas par route coûteuse (indépendants du bucket global,
# par IP+route) : agent ask 20/min, multi-ask 30/min, explain 30/min,
# train & pipeline 5/HEURE, transport MCP 30/min. Chaque dépassement est
# journalisé en WARNING (rate_limit_exceeded).
#RATE_LIMIT_REDIS_URL=
# URL Redis optionnelle pour PARTAGER les quotas entre réplicas (INCR+EXPIRE,
# fail-open si Redis tombe). Absente = compteurs en mémoire locale. Le package
# « redis » n'est pas une dépendance dure : pip install redis pour l'activer.

# --- Agent IA : provider LLM -----------------------------------------------------------
# « ollama » (défaut), « openrouter », « hf » ou « lm_studio »
AGENT_PROVIDER=ollama

# Modèle par défaut de l'agent (selon le provider) :
#   Ollama     -> llama3.1:8b            OpenRouter -> vendor/model (ex: deepseek/deepseek-r1:free)
#   HF         -> meta-llama/Llama-3.1-8B-Instruct  LM Studio -> (vide = modèle chargé dans LM Studio)
#AGENT_MODEL_NAME=llama3.1:8b
# Endpoints des providers (déjà supportés par défaut) :
#AGENT_OLLAMA_URL=http://192.168.1.184:11434/api/chat
#AGENT_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Clé API OpenRouter — REQUISE dès que AGENT_PROVIDER=openrouter (https://openrouter.ai/keys)
#OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Hugging Face Inference Providers (provider « hf ») --------------------------------
# Endpoint compatible OpenAI (racine « /v1 » acceptée aussi) :
#AGENT_HF_URL=https://router.huggingface.co/v1/chat/completions
# Clé HF — REQUISE dès que AGENT_PROVIDER=hf (https://huggingface.co/settings/tokens)
# HF_API_KEY est lue en priorité, HF_TOKEN en repli.
#HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LM Studio (provider « lm_studio ») --------------------------------------------------
# Serveur LOCAL compatible OpenAI : démarrez-le dans LM Studio (onglet Developer
# > Local Server, port 1234 par défaut). Racine « /v1 » acceptée aussi.
# AUCUNE clé API requise ; la fenêtre de contexte se règle dans l'UI LM Studio.
#AGENT_LM_STUDIO_URL=http://192.168.1.184:1234/v1/chat/completions

# Réglages optionnels de l'agent :
#AGENT_TIMEOUT_SECONDS=600
#AGENT_CONTEXT_LENGTH=2048
#AGENT_LOG_LEVEL=INFO
# WebSocket /train/stream : jeton dedie au dashboard (defaut : API_KEY)
DASHBOARD_WS_TOKEN=
# Anti-stall : minutes sans nouvel epoch avant fermeture du flux (defaut 5)
TRAIN_STREAM_STALL_MINUTES=5

# --- Nouveau noyau agentique (POST /api/agent/ask/core) --------------------------
# 1 = active le noyau app/agent/core.py (Intent -> Plan -> Policy -> Budget)
AGENT_NEW_CORE=1
# Budgets du noyau (rounds LLM / appels d'outils max par run)
AGENT_MAX_LLM_ROUNDS=6
AGENT_MAX_TOOL_CALLS=20

# --- Recherche web de l'agent (outil web_search) ---------------------------------------
# Backend : auto (SearXNG en primaire, repli DuckDuckGo Lite), searxng ou ddg
#AGENT_SEARCH_BACKEND=auto
# Instance SearXNG (endpoint /search, format=json requis dans search.formats) :
#   conteneur compose « searxng » : http://searxng:8080/search
#   instance hors compose         : http://127.0.0.1:8888/search
#AGENT_SEARXNG_URL=http://127.0.0.1:8888/search
# Langue des résultats SearXNG (vide = défaut de l'instance)
#AGENT_SEARCH_LANGUAGE=fr
# Hôtes privés autorisés malgré la protection SSRF (CSV) — ex. pour
# joindre l'instance SearXNG locale depuis l'agent.
# P0 SEC (F8) : protection SSRF ACTIVE PAR DÉFAUT (fail-closed) — opt-out
# explicite uniquement : AGENT_BLOCK_PRIVATE_HOSTS=0 (dev local sans SearXNG).
# Compose injecte déjà l'allowlist (searxng,127.0.0.1,localhost) pour le
# service « app ».
#AGENT_PRIVATE_HOST_ALLOWLIST=127.0.0.1,localhost,searxng
#AGENT_BLOCK_PRIVATE_HOSTS=0

# --- Déploiement (Docker / Render) -----------------------------------------------------
# Workers gunicorn (défaut image : 1, calibré 512 Mo ; sur un plan >= 2 Go, 2
# redevient viable). Render injecte WEB_CONCURRENCY=1 : utilisé en repli si
# GUNICORN_WORKERS n'est pas défini.
#GUNICORN_WORKERS=1
# 0 = démarrage de l'API sans charger de modèle (défaut de l'image Docker) ;
#     /api/v1/health répond immédiatement, sanity disponible via
#     GET /health/model-sanity. Mettre 1 sur un plan >= 2 Go.
#MODEL_SANITY_ON_STARTUP=1
# 0 = pas de préchargement du classifieur sentiment au démarrage (défaut image)
#CLASSIFIER_WARMUP=1

# ============================================================================
# P2 DURABLE (hardening) — sécurité / privacy / résilience
# ============================================================================

# --- Lot 13 : JWT + service accounts + vault --------------------------------
# Clé de signature HS256 des JWT courte durée (défaut 15 min). Recommandé en
# prod : 32+ octets aléatoires (python -c "import secrets; print(secrets.token_urlsafe(32))").
# Absente : dérivée SHA-256 de API_KEY (repli sûr, non réversible).
#JWT_SECRET=
# Backend de secrets : env (défaut), doppler, infisical, azure — CSV pour le
# fail-over (ex. doppler,env). Les accès sont AUDITÉS (action secret_access).
#VAULT_BACKEND=env
# Tokens d'accès aux backends vault (bootstrap minimal, restent dans l'env) :
#DOPPLER_TOKEN=
#INFISICAL_TOKEN=
#INFISICAL_URL=
#INFISICAL_PROJECT_ID=
#AZURE_KEY_VAULT_URI=
#AZURE_TENANT_ID=
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=
# Base SQLite des service accounts (client credentials -> JWT) :
#SERVICE_ACCOUNTS_PATH=experiments/service_accounts.db

# --- Lot 15 : supply-chain ---------------------------------------------------
# Exige un manifeste sha256.json signé sur chaque version modèle chargée
# (généré par core.model_versioning après entraînement). Recommandé en prod.
#MODEL_SIGNING_REQUIRED=0

# --- Lot 16 : privacy / résilience -------------------------------------------
# Chiffrement au repos des stores sessions/audit (Fernet). OBLIGATOIRE en prod
# (fail-closed au démarrage) :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#STORE_ENCRYPTION_KEY=
# Clé dédiée des backups chiffrés (scripts/backup_encrypted.py), repli :
# STORE_ENCRYPTION_KEY.
#BACKUP_ENCRYPTION_KEY=
# Répertoires backup / restauration :
#BACKUP_DIR=experiments/backups
#BACKUP_RESTORE_DIR=experiments/restore
# TTL de purge (scripts/retention.py) :
#RETENTION_SESSIONS_DAYS=90
#RETENTION_AUDIT_DAYS=365
# Plafond d'entraînements CONCURRENTS + file d'attente bornée (0 = illimité) :
#TRAIN_MAX_CONCURRENT=1
#TRAIN_QUEUE_MAX=2
#TRAIN_QUEUE_TIMEOUT=15

# --- Lot 17 : LLM-sécurité ----------------------------------------------------
# Garde anti prompt-injection (défaut 1 = actif). 0 = opt-out explicite :
# les prompts « high » ne sont plus neutralisés, les sorties d'outils
# suspectes ne sont plus tronquées.
#AGENT_PROMPT_INJECTION_GUARD=1
# Validation stricte du schéma de plan LLM : off | warn (défaut) | strict
# (strict = plan hors schéma rejeté + auto-correction, zéro appel d'outil).
#AGENT_PLAN_VALIDATION=warn
