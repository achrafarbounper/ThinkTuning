# ==============================================================================
# Exemple de configuration d'environnement du FRONTEND (Vite).
# Copier en .env.local (LOCAL, ignoré par git via *.local) et/ou
# .env.production (PROD, injecté au build).
#
# Règle : seules les variables préfixées VITE_ sont exposées au bundle
# (import.meta.env.VITE_*). Ne JAMAIS y mettre de secret côté client.
# ==============================================================================

# --- Connexion API (obligatoire) ----------------------------------------------
# LOCAL  : backend FastAPI lancé sur votre machine (uvicorn, port 8000).
# PROD   : backend Render — https://thinktuning.onrender.com
# Sans cette variable, clientCore.ts retombe sur http://localhost:8000 :
# correct en LOCAL, CASSE en prod (mixed content + localhost = poste client).
VITE_API_URL=http://localhost:8000

# --- Paramètres par défaut de l'assistant IA (optionnels) ---------------------
# Pré-remplissent les réglages agent (voir src/api/agentSettings.ts).
#VITE_AGENT_PROVIDER=ollama
#VITE_AGENT_OLLAMA_URL=http://192.168.1.184:11434/api/chat
#VITE_AGENT_OPENROUTER_URL=https://openrouter.ai/api/v1
#VITE_OPENROUTER_API_KEY=
#VITE_AGENT_HF_URL=https://router.huggingface.co/v1
#VITE_HF_API_KEY=
#VITE_AGENT_LM_STUDIO_URL=http://192.168.1.184:1234/v1
#VITE_AGENT_TIMEOUT_SECONDS=600
#VITE_AGENT_CONTEXT_LENGTH=2048
#VITE_AGENT_TEMPERATURE=0.2
