# ============================================================================
# Template nginx du dashboard (envsubst exécuté par l'image officielle nginx :
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf au démarrage).
#
# Variables (fournies par frontend/Dockerfile, surchargeables au run) :
#   FRONTEND_PORT : port d'écoute (8080 : compatible user non-root)
#   API_UPSTREAM  : cible des proxys /api et /mcp (nom de service compose
#                   « app:8000 », ou hôte:port externe)
#   API_KEY       : clé admin de l'API — le proxy l'INJECTE en X-API-Key sur
#                   les requêtes /api et /mcp (P1 point 10b : le navigateur ne
#                   stocke JAMAIS la clé). Vide → aucun header injecté (mode
#                   dev / clé fournie par le client).
#
# Surface identique au proxy Vite de dev (vite.config.ts : /api + /mcp) —
# les flux SSE/WebSocket de l'agent transitent par /api/agent/* : en-têtes
# Upgrade + buffering off + timeout long OBLIGATOIRES ici.
# ============================================================================
# P1 : injection conditionnelle — X-API-Key n'est posé QUE si API_KEY est
# définie (une valeur vide via proxy_set_header SUPPRIME le header : aucun
# « X-API-Key: » vide ne part vers l'API).
map $API_KEY $api_key_header {
    ""      "";
    default $API_KEY;
}

server {
    listen ${FRONTEND_PORT};
    server_name _;

    # P1 SEC (F11) : ne pas divulguer la version d'nginx (en-tête Server).
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # P0 SEC (F7) : en-têtes de durcissement sur TOUTES les réponses (y
    # compris le SPA statique) — anti-clickjacking / MIME-sniffing / XSS.
    # CSP stricte : même origine uniquement (le dashboard ne charge ni CDN
    # ni inline tiers) ; frame-ancestors 'none' (pas d'iframe).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    # P1 SEC (F10) : HSTS INCONDITIONNEL — ce conteneur nginx est TOUJOURS
    # derrière TLS en production (Render/Vercel/Cloudflare le terminent) ;
    # en local HTTP pur la policy est inertes pour le navigateur (hôte non
    # préchargé, pas d'effet), donc plus aucun risque de HSTS « indésirable »
    # ne justifie de la désactiver. max-age 1 an + preload.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Corps de requêtes borné : l'API impose déjà ses propres plafonds
    # (PREDICT_*/batch) ; nginx coupe avant (anti Slowloris volumétrique).
    client_max_body_size 12m;
    client_body_timeout 30s;
    client_header_timeout 15s;

    # Proxy des appels /api/* vers l'API FastAPI (conteneur séparé).
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # P1 : la clé n'est JAMAIS stockée côté navigateur — le proxy la
        # replace ici (map ci-dessus : vide = header non envoyé).
        proxy_set_header X-API-Key $api_key_header;
        # SSE (agent, métriques) et WebSocket : pas de buffering, upgrade,
        # pas de timeout court (streams de plusieurs minutes).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        limit_req zone=api_burst burst=60 nodelay;
    }

    # Transport MCP (POST /mcp/sse) : la réponse est un flux SSE à événement
    # unique (JSON-RPC). Un tour `orchestrate` peut durer plusieurs minutes :
    # HTTP/1.1 + buffering off + timeout long OBLIGATOIRES ici aussi (sans ce
    # bloc, /mcp/sse tomberait dans le fallback SPA et casserait les modes
    # MCP du chat en déploiement same-origin).
    location /mcp/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $api_key_header;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        limit_req zone=api_burst burst=20 nodelay;
    }

    # SPA : tout le reste sert index.html (routing côté client).
    location / {
        try_files $uri $uri/ /index.html;
    }
}